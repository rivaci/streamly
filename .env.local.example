# Get a free TMDB API token at https://www.themoviedb.org/settings/api
# Use the v4 "API Read Access Token" (long Bearer token).
TMDB_ACCESS_TOKEN=

# Optional v3 key fallback (not used if v4 token is set).
TMDB_API_KEY=

# Public site URL for Open Graph metadata (must include scheme, no trailing slash).
# Example production: https://streamly.example.com — optional on localhost.
NEXT_PUBLIC_SITE_URL=

# Default site locale (fr | en).
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# Default region for streaming providers (ISO 3166-1, e.g. FR, US).
NEXT_PUBLIC_PROVIDER_REGION=FR
