{
  "name": "streaming-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Streaming platform POC — Next.js 15 (App Router) + TS + TMDB. SSR / ISR, i18n FR/EN, a11y, Core Web Vitals oriented.",
